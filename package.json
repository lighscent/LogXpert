{
  "name": "logxpert",
  "version": "2.0.3",
  "description": "A powerful logging library for Node.js with colorful output and daily file rotation",
  "main": "main.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./main.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./main.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "main.js",
    "main.mjs",
    "index.d.ts",
    "index.d.mts",
    "lib/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lighscent/LogXpert.git"
  },
  "bugs": {
    "url": "https://github.com/lighscent/LogXpert/issues"
  },
  "homepage": "https://github.com/lighscent/LogXpert#readme",
  "author": "https://github.com/lighscent",
  "license": "Apache-2.0",
  "keywords": [
    "logging",
    "logger",
    "winston",
    "daily-rotate",
    "nodejs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/logger.test.js test/lib.test.js",
    "check:types": "tsc -p test-d --noEmit && echo TYPES-OK",
    "attw": "attw --pack"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "typescript": "^7.0.2"
  }
}
