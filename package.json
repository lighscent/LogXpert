{
  "name": "logxpert",
  "version": "2.2.2",
  "description": "A powerful logging library for Node.js with colorful output and daily file rotation",
  "main": "main.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./main.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./main.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "main.js",
    "main.mjs",
    "index.d.ts",
    "index.d.mts",
    "lib/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lighscent/LogXpert.git"
  },
  "bugs": {
    "url": "https://github.com/lighscent/LogXpert/issues"
  },
  "homepage": "https://github.com/lighscent/LogXpert#readme",
  "author": "https://github.com/lighscent",
  "license": "Apache-2.0",
  "keywords": [
    "logging",
    "logger",
    "winston",
    "daily-rotate",
    "nodejs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-reporter=./test/reporter.js test/logger.test.js test/console.test.js test/files.test.js test/lib/event.test.js test/lib/context.test.js test/lib/format.test.js test/lib/time.test.js test/lib/sanitize.test.js test/lib/mini.test.js test/lib/rotate.test.js",
    "test:demo": "node --test --test-reporter=./test/reporter.js demo/reporter.demo.test.js",
    "check:types": "tsc -p test-d --noEmit && echo TYPES-OK",
    "attw": "attw --pack",
    "bench": "node benchmarks/scripts/run.js --suite standard --sink null",
    "bench:quick": "node benchmarks/scripts/run.js --suite quick --sink null",
    "bench:report": "node benchmarks/scripts/report.js --all"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "bunyan": "^1.8.15",
    "pino": "^10.4.0",
    "typescript": "^7.0.2",
    "winston": "^3.19.0"
  }
}
